#=================#
#   AWS Bedrock   #
#=================#

# BEDROCK_AWS_DEFAULT_REGION=us-east-1 # 必须提供默认区域
# BEDROCK_AWS_ACCESS_KEY_ID=someAccessKey
# BEDROCK_AWS_SECRET_ACCESS_KEY=someSecretAccessKey
# BEDROCK_AWS_SESSION_TOKEN=someSessionToken

# 注意: 此示例列表并非详尽无遗。如果省略，所有已知的、受支持的模型 ID 将自动为您包含。
# BEDROCK_AWS_MODELS=anthropic.claude-3-5-sonnet-20240620-v1:0,meta.llama3-1-8b-instruct-v1:0

# 在此处查看所有 Bedrock 模型 ID: https://docs.aws.amazon.com/bedrock/latest/userguide/model-ids.html#model-ids-arns

# 关于特定模型的说明:
# 由于不支持流式传输，以下模型不受支持:
# ai21.j2-mid-v1

# 由于不支持对话历史记录，以下模型不受支持:
# ai21.j2-ultra-v1, cohere.command-text-v14, cohere.command-light-text-v14

#============#
# Google     #
#============#

GOOGLE_KEY=user_provided

# GOOGLE_REVERSE_PROXY=
# 某些反向代理不支持 X-goog-api-key 标头，取消注释以在 Authorization 标头中传递 API 密钥。
# GOOGLE_AUTH_HEADER=true

# Gemini API (AI Studio)
# GOOGLE_MODELS=gemini-2.5-pro,gemini-2.5-flash,gemini-2.5-flash-lite,gemini-2.0-flash,gemini-2.0-flash-lite

# Vertex AI
# GOOGLE_MODELS=gemini-2.5-pro,gemini-2.5-flash,gemini-2.5-flash-lite,gemini-2.0-flash-001,gemini-2.0-flash-lite-001

# GOOGLE_TITLE_MODEL=gemini-2.0-flash-lite-001

# Vertex AI 的 Google Cloud 区域（用于聊天和图像生成）
# GOOGLE_LOC=us-central1

# Gemini 图像生成的替代区域环境变量
# GOOGLE_CLOUD_LOCATION=global

# Vertex AI 服务账号配置
# 您的 Google Cloud 服务账号 JSON 文件的路径
# GOOGLE_SERVICE_KEY_FILE=/path/to/service-account.json

# Google 安全设置
# 注意: 这些设置适用于 Vertex AI 和 Gemini API (AI Studio)
#
# 对于 Vertex AI:
# 要使用 BLOCK_NONE 设置，您需要：
# (a) 通过您的 Google 客户团队获得许可名单访问权限，或
# (b) 切换到按月开票结算: https://cloud.google.com/billing/docs/how-to/invoiced-billing
#
# 对于 Gemini API (AI Studio):
# 默认情况下可用 BLOCK_NONE，无需特殊帐户要求。
#
# 可用选项: BLOCK_NONE, BLOCK_ONLY_HIGH, BLOCK_MEDIUM_AND_ABOVE, BLOCK_LOW_AND_ABOVE
#
# GOOGLE_SAFETY_SEXUALLY_EXPLICIT=BLOCK_ONLY_HIGH
# GOOGLE_SAFETY_HATE_SPEECH=BLOCK_ONLY_HIGH
# GOOGLE_SAFETY_HARASSMENT=BLOCK_ONLY_HIGH
# GOOGLE_SAFETY_DANGEROUS_CONTENT=BLOCK_ONLY_HIGH
# GOOGLE_SAFETY_CIVIC_INTEGRITY=BLOCK_ONLY_HIGH

#========================#
# Gemini 图像生成         #
#========================#

# Gemini 图像生成工具（用于 Agent）
# 支持多种认证方法，按优先级排序：
# 1. 用户提供的 API 密钥（通过 GUI）
# 2. GEMINI_API_KEY 环境变量（管理员配置）
# 3. GOOGLE_KEY 环境变量（与 Google 聊天端点共享）
# 4. Vertex AI 服务账号（通过 GOOGLE_SERVICE_KEY_FILE）

# 选项 A: 使用专用的 Gemini API 密钥进行图像生成
# GEMINI_API_KEY=your-gemini-api-key

# 选项 B: 使用 Vertex AI（无需 API 密钥，使用服务账号）
# 设置此项以启用 Vertex AI 并允许工具无需 API 密钥即可使用
# GEMINI_VERTEX_ENABLED=true

# 用于图像生成的 Vertex AI 模型（默认为 gemini-2.5-flash-image）
# GEMINI_IMAGE_MODEL=gemini-2.5-flash-image

