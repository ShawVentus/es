#=====================================================================#
#                       LibreChat 配置                                 #
#=====================================================================#
# 请参考文档以获取有关配置 LibreChat 环境的帮助。                          #
#                                                                     #
# https://www.librechat.ai/docs/configuration/dotenv                  #
#=====================================================================#

#==================================================#
#               服务器配置                           #
#==================================================#

HOST=localhost
PORT=3080

MONGO_URI=mongodb://127.0.0.1:27017/LibreChat
# 连接池中的最大连接数。 */
MONGO_MAX_POOL_SIZE=
# 连接池中的最小连接数。 */
MONGO_MIN_POOL_SIZE=
# 连接池可以并发建立的最大连接数。 */
MONGO_MAX_CONNECTING=
# 连接在被移除并关闭之前，可以在池中保持空闲的最大毫秒数。 */
MONGO_MAX_IDLE_TIME_MS=
# 线程在等待连接变得可用时，可以等待的最大毫秒数。 */
MONGO_WAIT_QUEUE_TIMEOUT_MS=
# 设置为 false 以禁用与此连接关联的所有模型的自动索引创建。 */
MONGO_AUTO_INDEX=
# 设置为 `false` 以禁用 Mongoose 在此连接上创建的每个模型上自动调用 `createCollection()`。 */
MONGO_AUTO_CREATE=

DOMAIN_CLIENT=http://localhost:3080
DOMAIN_SERVER=http://localhost:3080

NO_INDEX=true
# 使用距离 Express 应用程序最多 n 跳的地址。
# req.socket.remoteAddress 是第一跳，其余的在 X-Forwarded-For 标头中从右到左查找。
# 值为 0 意味着第一个不受信任的地址将是 req.socket.remoteAddress，即没有反向代理。
# 默认为 1。
TRUST_PROXY=1

# 用户认证的最小密码长度
# 默认值: 8
# 注意: 当使用 LDAP 认证时，您可能希望将其设置为 1
# 以绕过本地密码验证，因为 LDAP 服务器处理它们自己的
# 密码策略。
# MIN_PASSWORD_LENGTH=8

#===============#
# JSON 日志     #
#===============#

# 在 GCP/AWS 等云部署中处理控制台日志时使用
CONSOLE_JSON=false

#===============#
# 调试日志      #
#===============#

DEBUG_LOGGING=true
DEBUG_CONSOLE=false

#=============#
# 权限        #
#=============#

# UID=1000
# GID=1000

#==============#
# Node 选项    #
#==============#

# 注意: NODE_MAX_OLD_SPACE_SIZE 不被 Node.js 直接识别。
# 此变量用作 Docker 或 CI/CD 工作流的构建参数，
# 并不被 Node.js 用于在运行时设置堆大小。
# 要配置 Node.js 内存，请使用 NODE_OPTIONS，例如：
# NODE_OPTIONS="--max-old-space-size=6144"
# 参见: https://nodejs.org/api/cli.html#--max-old-space-sizesize-in-mib
NODE_MAX_OLD_SPACE_SIZE=6144

#===============#
# 配置          #
#===============#
# 使用绝对路径、相对路径或 URL

# CONFIG_PATH="/alternative/path/to/librechat.yaml"

#===================================================#
#                     服务端点                      #
#===================================================#

# ENDPOINTS=openAI,assistants,azureOpenAI,google,anthropic

# PROXY=

