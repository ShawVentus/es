APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY_PATH=
APPLE_CALLBACK_URL=/oauth/apple/callback

# OpenID
OPENID_CLIENT_ID=
OPENID_CLIENT_SECRET=
OPENID_ISSUER=
OPENID_SESSION_SECRET=
OPENID_SCOPE="openid profile email"
OPENID_CALLBACK_URL=/oauth/openid/callback
OPENID_REQUIRED_ROLE=
OPENID_REQUIRED_ROLE_TOKEN_KIND=
OPENID_REQUIRED_ROLE_PARAMETER_PATH=
OPENID_ADMIN_ROLE=
OPENID_ADMIN_ROLE_PARAMETER_PATH=
OPENID_ADMIN_ROLE_TOKEN_KIND=
# 设置以确定将从 OpenID 提供程序返回的哪个用户信息属性存储为用户的用户名
OPENID_USERNAME_CLAIM=
# 设置以确定将从 OpenID 提供程序返回的哪个用户信息属性存储为用户的姓名
OPENID_NAME_CLAIM=
# OpenID 授权请求的可选受众参数
OPENID_AUDIENCE=

OPENID_BUTTON_LABEL=
OPENID_IMAGE_URL=
# 设置为 true 以在用户访问登录页面时自动重定向到 OpenID 提供程序
# 这将完全绕过用户的登录表单，仅当 OpenID 是您唯一的身份验证方法时才使用此功能
OPENID_AUTO_REDIRECT=false
# 设置为 true 以使用 PKCE (Proof Key for Code Exchange) 进行 OpenID 认证
OPENID_USE_PKCE=false
# 设置为 true 以重用 openid 令牌进行认证管理，而不是使用 mongodb 会话和自定义刷新令牌。
OPENID_REUSE_TOKENS=
# 默认情况下，缓存签名密钥验证结果以防止向 JWKS 端点发出过多的 HTTP 请求。
# 如果找到匹配 kid 的签名密钥，它将被缓存，下次请求此 kid 时，签名密钥将从缓存中提供。
# 默认为 true。
OPENID_JWKS_URL_CACHE_ENABLED=
OPENID_JWKS_URL_CACHE_TIME= # 600000 ms 等于 10 分钟，留空以禁用缓存
# 设置为 true 以触发令牌交换流程以获取 userinfo 端点的访问令牌。
OPENID_ON_BEHALF_FLOW_FOR_USERINFO_REQUIRED=
OPENID_ON_BEHALF_FLOW_USERINFO_SCOPE="user.read" # Microsoft Graph API 所需的 Scope 示例
# 设置为 true 以使用 OpenID Connect 结束会话端点进行注销
OPENID_USE_END_SESSION_ENDPOINT=
# OpenID 注销后重定向的 URL (默认为 ${DOMAIN_CLIENT}/login)
OPENID_POST_LOGOUT_REDIRECT_URI=

#========================#
# SharePoint 集成        #
#========================#
# 需要配置 Entra ID (OpenID) 认证

# 启用聊天和代理面板中的 SharePoint 文件选择器
# ENABLE_SHAREPOINT_FILEPICKER=true

# SharePoint 租户基础 URL (例如，https://yourtenant.sharepoint.com)
# SHAREPOINT_BASE_URL=https://yourtenant.sharepoint.com

# 用于文件选择器的 Microsoft Graph API 和 SharePoint 范围
# SHAREPOINT_PICKER_SHAREPOINT_SCOPE==https://yourtenant.sharepoint.com/AllSites.Read
# SHAREPOINT_PICKER_GRAPH_SCOPE=Files.Read.All
#========================#

# SAML
# 注意: 如果启用 OpenID，SAML 认证将被自动禁用。
SAML_ENTRY_POINT=
SAML_ISSUER=
SAML_CERT=
SAML_CALLBACK_URL=/oauth/saml/callback
SAML_SESSION_SECRET=

# 属性映射 (可选)
SAML_EMAIL_CLAIM=
SAML_USERNAME_CLAIM=
SAML_GIVEN_NAME_CLAIM=
SAML_FAMILY_NAME_CLAIM=
SAML_PICTURE_CLAIM=
SAML_NAME_CLAIM=

# 登录按钮设置 (可选)
SAML_BUTTON_LABEL=
SAML_IMAGE_URL=

# 是否应对 SAML 响应进行签名。
# - 如果为 "true"，则将对整个 `SAML Response` 进行签名。
# - 如果为 "false" 或未设置，则仅对 `SAML Assertion` 进行签名（默认行为）。
# SAML_USE_AUTHN_RESPONSE_SIGNED=


#===============================================#
# Microsoft Graph API / Entra ID 集成         #
#===============================================#

# 在权限/共享系统中启用 Entra ID 人员搜索集成
# 启用后，人员选择器将搜索本地数据库和 Entra ID
USE_ENTRA_ID_FOR_PEOPLE_SEARCH=false

# 启用后，Entra ID 组所有者将被视为该组的成员
ENTRA_ID_INCLUDE_OWNERS_AS_MEMBERS=false

# 人员/组搜索所需的 Microsoft Graph API 范围
# 默认范围提供对用户个人资料和组成员资格的访问
OPENID_GRAPH_SCOPES=User.Read,People.Read,GroupMember.Read.All

# LDAP
LDAP_URL=
LDAP_BIND_DN=
LDAP_BIND_CREDENTIALS=
LDAP_USER_SEARCH_BASE=
#LDAP_SEARCH_FILTER="mail="
LDAP_CA_CERT_PATH=
# LDAP_TLS_REJECT_UNAUTHORIZED=
# LDAP_STARTTLS=
# LDAP_LOGIN_USES_USERNAME=true
# LDAP_ID=
# LDAP_USERNAME=
