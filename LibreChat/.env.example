FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=

#========================#
# S3 AWS Bucket          #
#========================#

AWS_ENDPOINT_URL=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
AWS_BUCKET_NAME=

#========================#
# Azure Blob Storage     #
#========================#

AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_PUBLIC_ACCESS=false
AZURE_CONTAINER_NAME=files

#========================#
# 共享链接               #
#========================#

ALLOW_SHARED_LINKS=true
ALLOW_SHARED_LINKS_PUBLIC=true

#==============================#
# 静态文件缓存控制             #
#==============================#

# 保持注释状态以使用默认值: s-maxage 为 1 天 (86400 秒)，max-age 为 2 天 (172800 秒)
# NODE_ENV 必须设置为 production 才能生效
# STATIC_CACHE_MAX_AGE=172800
# STATIC_CACHE_S_MAX_AGE=86400

# 如果您的 LibreChat 前面有另一个服务进行压缩，请在此处禁用基于 express 的压缩
# DISABLE_COMPRESSION=true

# 如果您在同一文件夹中有上传图片的 gzip 版本，这将启用 gzip 扫描并提供这些图片
# 注意: 图片文件夹将在启动时被扫描，并保留在内存中。如果图片数量很大，请小心。
# ENABLE_IMAGE_OUTPUT_GZIP_SCAN=true

#===================================================#
#                        UI                         #
#===================================================#

APP_TITLE=LibreChat
# CUSTOM_FOOTER="My custom footer"
HELP_AND_FAQ_URL=https://librechat.ai

# SHOW_BIRTHDAY_ICON=true

# Google tag manager id
#ANALYTICS_GTM_ID=user provided google tag manager id

# 将对话文件导入限制为特定字节大小，以避免容器
# 因通过取消注释此行并提供以字节为单位的文件大小而耗尽内存限制
# 例如下面的 250 mib 示例
# CONVERSATION_IMPORT_MAX_FILE_SIZE_BYTES=262144000


#===============#
# REDIS 选项    #
#===============#

# 启用 Redis 用于缓存和会话存储
# USE_REDIS=true
# 启用 Redis 用于可恢复的 LLM 流（如果未设置，默认为 USE_REDIS 的值）
# 设置为 false 以使用内存存储用于流，同时保留 Redis 用于其他缓存
# USE_REDIS_STREAMS=true

# 单个 Redis 实例
# REDIS_URI=redis://127.0.0.1:6379

# Redis 集群（多个节点）
# REDIS_URI=redis://127.0.0.1:7001,redis://127.0.0.1:7002,redis://127.0.0.1:7003

# 带 TLS/SSL 加密和 CA 证书的 Redis
# REDIS_URI=rediss://127.0.0.1:6380
# REDIS_CA=/path/to/ca-cert.pem

# Elasticache 可能需要使用替代的 dnsLookup 进行 TLS 连接。参见此网页上的 "Special Note: Aws Elasticache Clusters with TLS": https://www.npmjs.com/package/ioredis
# 为 redis 启用替代 dnsLookup
# REDIS_USE_ALTERNATIVE_DNS_LOOKUP=true

# Redis 认证（如果需要）
# REDIS_USERNAME=your_redis_username
# REDIS_PASSWORD=your_redis_password

# Redis 键前缀配置
# 将环境变量名称用于动态前缀（推荐用于云部署）
# REDIS_KEY_PREFIX_VAR=K_REVISION
# 或者直接使用静态前缀
# REDIS_KEY_PREFIX=librechat

# Redis 连接限制
# REDIS_MAX_LISTENERS=40

# 以秒为单位的 Redis ping 间隔 (0 = 禁用, >0 = 启用)
# 当设置为正整数时，Redis 客户端将以此间隔 ping 服务器以保持连接活动
# 当未设置或为 0 时，不执行 ping 操作（推荐用于大多数用例）
# REDIS_PING_INTERVAL=300

# 强制特定的缓存命名空间使用内存存储，即使已启用 Redis
# 逗号分隔的 CacheKeys 列表 (例如: ROLES,MESSAGES)
# FORCED_IN_MEMORY_CACHE_NAMESPACES=ROLES,MESSAGES

# 领导者选举配置（用于带 Redis 的多实例部署）
# 领导者租约在过期前的有效持续时间（秒）（默认: 25）
# LEADER_LEASE_DURATION=25
# 领导者续订租约的间隔（秒）（默认: 10）
# LEADER_RENEW_INTERVAL=10
# 续订租约失败时的最大重试次数（默认: 3）
# LEADER_RENEW_ATTEMPTS=3
# 续订租约重试尝试之间的延迟（秒）（默认: 0.5）
# LEADER_RENEW_RETRY_DELAY=0.5

#==================================================#
#                      其他                        #
#==================================================#
#   您应该将以下内容保持注释状态                   #

# NODE_ENV=

# E2E_USER_EMAIL=
# E2E_USER_PASSWORD=

#=====================================================#
#                  缓存标头                           #
#=====================================================#
#   控制 index.html 缓存的标头                        #
#   默认配置阻止缓存以确保                           #
#   用户始终获得最新版本。仅当                       #
#   您了解缓存含义时才进行自定义。                    #

# INDEX_CACHE_CONTROL=no-cache, no-store, must-revalidate
# INDEX_PRAGMA=no-cache
# INDEX_EXPIRES=0

# no-cache: 强制在使用缓存版本之前与服务器进行验证
# no-store: 阻止完全存储响应
# must-revalidate: 阻止在离线时使用陈旧内容

#=====================================================#
#                  OpenWeather                        #
#=====================================================#
OPENWEATHER_API_KEY=

#====================================#
# LibreChat 代码解释器 API           #
#====================================#

# https://code.librechat.ai
# LIBRECHAT_CODE_API_KEY=your-key

#======================#
# 网络搜索             #
#======================#

# 注意: 所有以下变量名称都可以自定义。
# 省略值以允许用户提供它们。

# For more information on configuration values, see:
# https://librechat.ai/docs/features/web_search

# Search Provider (Required)
# SERPER_API_KEY=your_serper_api_key

# Scraper (Required)
# FIRECRAWL_API_KEY=your_firecrawl_api_key
# Optional: Custom Firecrawl API URL
# FIRECRAWL_API_URL=your_firecrawl_api_url

# Reranker (Required)
# JINA_API_KEY=your_jina_api_key
# or
# COHERE_API_KEY=your_cohere_api_key

#======================#
# MCP 配置             #
#======================#

# 当未找到 oauth 元数据时，将 401/403 响应视为 OAuth 要求
# MCP_OAUTH_ON_AUTH_ERROR=true

# OAuth 检测请求的超时时间（以毫秒为单位）
# MCP_OAUTH_DETECTION_TIMEOUT=5000

# 缓存连接状态检查这么多毫秒，以避免昂贵的验证
# MCP_CONNECTION_CHECK_TTL=60000

# 跳过代码质询方法验证 (例如, 针对支持 S256 但不发布它的 AWS Cognito)
# 当设置为 true 时，即使在 .well-known/openid-configuration 中未发布，也强制实施 S256 代码质询
# MCP_SKIP_CODE_CHALLENGE_CHECK=false


# MCP 调试
MCP_DEBUG=false
